# Django local development
SECRET_KEY=change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local development: blank DATABASE_URL uses db.sqlite3.
# Production: set this to the Supabase PostgreSQL connection URI.
DATABASE_URL=

# Local by default. In Render, set MEDIA_STORAGE=supabase and configure all S3 values below.
MEDIA_STORAGE=local
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Optional Supabase API client for other integrations (not used for Django file storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# App
HOSPITAL_NAME=Centro Médico SHINE
HOSPITAL_PRIMARY_COLOR=#22c55e
HOSPITAL_TIME_ZONE=America/Sao_Paulo

# Discord OAuth prepared (disabled by default)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback/
DISCORD_GUILD_ID=
DISCORD_OAUTH_ENABLED=False
