# Django
SECRET_KEY=change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Supabase PostgreSQL direct connection.
# Example from Supabase Project Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional Supabase API client for storage/realtime/fallback operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# App
HOSPITAL_NAME=Centro Médico SHINE
HOSPITAL_PRIMARY_COLOR=#22c55e
HOSPITAL_TIME_ZONE=America/Sao_Paulo

# Discord OAuth preparado (desativado por padrão no desenvolvimento)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback/
DISCORD_GUILD_ID=
DISCORD_OAUTH_ENABLED=False
